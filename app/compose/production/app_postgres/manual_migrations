#!/bin/bash
echo COLLECTSTATIC
python /src/manage.py collectstatic --noinput
echo PUBLICATIONS
mkdir /src/cdn_static_root/assets/publications
cp /var/publications/*.pdf /src/cdn_static_root/assets/publications/
echo SHOWMIGRATIONS ONLY
python /src/manage.py showmigrations
python /src/manage.py update_assettype --update
python /src/manage.py update_valuetype --update
echo UPDATETRANSLATIONS
python /src/manage.py compilemessages
echo $(ls -L 1 --dirsfirst)
gunicorn epa.wsgi:application --bind 0.0.0.0:8000 --workers=4 --timeout=120
